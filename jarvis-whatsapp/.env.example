# ============================================================
# Jarvis WhatsApp — configuração
# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# ============================================================

# --- Servidor ---
PORT=3000

# --- WhatsApp Cloud API (Meta) ---
# Token permanente do System User (Business Settings > Usuários do sistema)
WHATSAPP_TOKEN=
# App Secret (developers.facebook.com > seu app > Configurações > Básico)
WHATSAPP_APP_SECRET=
# Texto qualquer inventado por você; o mesmo vai no painel do webhook da Meta
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-longo-e-aleatorio
# ID do número de telefone (WhatsApp > Configuração da API). Usado pelo modo chat/simulação.
WHATSAPP_PHONE_NUMBER_ID=
# Versão da Graph API
GRAPH_API_VERSION=v23.0
# true = não envia nada para o WhatsApp, só mostra no terminal (bom para testes)
WHATSAPP_DRY_RUN=false

# --- Dono / atendente humano ---
# Número que recebe os avisos de transferência e pode mandar #pausar / #retomar
# Formato internacional só com dígitos: 5511999999999
OWNER_WHATSAPP=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (low = respostas rápidas e baratas, ideal para atendimento)
CLAUDE_EFFORT=low
# "default" = se o modelo recusar, a Anthropic tenta um modelo reserva automaticamente.
# Deixe vazio se trocar para um modelo sem suporte (ex.: Haiku).
CLAUDE_FALLBACKS=default

# --- Comportamento do Jarvis ---
# Espera (ms) para juntar mensagens picadas do cliente antes de responder
DEBOUNCE_MS=3000
# Quantas mensagens guardar antes de resumir a conversa
MAX_HISTORY_MESSAGES=40
# Fuso horário usado para informar data/hora ao Jarvis
TIMEZONE=America/Sao_Paulo

# --- Integrações opcionais ---
# Se preenchido, cada lead registrado é enviado via POST JSON para esta URL
# (ex.: webhook do n8n, Make, Zapier ou do seu CRM)
LEADS_WEBHOOK_URL=
